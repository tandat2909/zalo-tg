# ─── Bắt buộc ────────────────────────────────────────────────────────────────

# Telegram Bot Token — lấy từ @BotFather (https://t.me/BotFather)
TG_TOKEN=1234567890:ABCDEFabcdef1234567890abcdefABCDEF123

# Telegram Forum Group ID (số âm, ví dụ: -1001234567890)
# Bot phải là admin của group này, group phải bật chế độ Topics (Supergroup)
TG_GROUP_ID=-1001234567890

# ─── Tuỳ chọn ────────────────────────────────────────────────────────────────

# Đường dẫn tới file credentials Zalo (mặc định: ./credentials.json)
# ZALO_CREDENTIALS_PATH=./credentials.json

# Thư mục lưu dữ liệu tạm của adapter (mặc định: ./data)
# DATA_DIR=./data

# Adapter mặc định không poll Telegram nữa; core-system sở hữu Telegram updates/commands/mapping.
# Chỉ bật lại khi cần fallback legacy Telegram handler cũ.
TELEGRAM_POLLING_ENABLED=0

# Fallback legacy stores cũ của adapter (topics/msg-map/sent-map/friends/groups/user-cache).
# Mặc định tắt để core-system là nguồn sự thật duy nhất cho mapping/cache.
BRIDGE_LEGACY_STORE_FALLBACK_ENABLED=0

# Bỏ qua tin nhắn từ nhóm Zalo đã tắt thông báo (mặc định: false)
# ZALO_SKIP_MUTED_GROUPS=0

# Core bridge target (bắt buộc khi chạy adapter ở chế độ mới)
# CORE_SYSTEM_BASE_URL=http://localhost:8080
# BRIDGE_INTERNAL_TOKEN=change-me
# CORE_ZALO_INBOUND_SHADOW_ENABLED=1
# CORE_ZALO_INBOUND_TAKEOVER_ENABLED=1
# CORE_TELEGRAM_COMMAND_TAKEOVER_ENABLED=1
# CORE_SYSTEM_TIMEOUT_MS=5000

# Webhook nhận tin nhắn mới từ Zalo (tuỳ chọn)
# Ví dụ: http://localhost:8080/api/v1/messages/incoming
# INCOMING_MESSAGE_WEBHOOK_URL=http://localhost:8080/api/v1/messages/incoming
# INCOMING_MESSAGE_WEBHOOK_TIMEOUT_MS=5000

# ─── Local Bot API Server (tuỳ chọn) ────────────────────────────────────────
# Tăng giới hạn file lên 2 GB (mặc định official API: 20 MB upload / 50 MB download)
#
# Hướng dẫn đầy đủ: xem LOCAL_BOT_API_SETUP.md
#
# Bật/tắt local Bot API:
#   1 = dùng local server tại TG_LOCAL_SERVER (cần cài telegram-bot-api binary)
#   0 = dùng official api.telegram.org (không cần cài gì thêm)
LOCAL_BOT_API=0

# Lấy TG_API_ID và TG_API_HASH tại: https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# URL của local Bot API server (chỉ dùng khi LOCAL_BOT_API=1)
TG_LOCAL_SERVER=http://localhost:8081
